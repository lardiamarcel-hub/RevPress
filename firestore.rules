rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Contenu de la revue de presse : lecture par tout utilisateur authentifié
    // (app à usage individuel), écriture réservée aux Cloud Functions (Admin SDK).
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /digests/{digestId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Configuration des sources et de la collecte : modifiable depuis l'écran
    // Réglages par un utilisateur authentifié.
    match /sources/{sourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
