{
  "name": "revue-eco-bf-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions pour Revue Éco BF — collecte, classification et digest de presse économique",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}
